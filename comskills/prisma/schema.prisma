generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Recording {
  id        String          @id @default(uuid())
  userId    String
  path      String
  seconds   Int
  sizeBytes Int
  mimeType  String
  status    RecordingStatus @default(UPLOADING)
  createdAt DateTime        @default(now())

  analysisStatus AnalysisStatus @default(NONE)
  transcript     String?
  analysis       Json?
  analysisError  String?
  analyzedAt     DateTime?
}

enum RecordingStatus {
  UPLOADING
  READY
}

enum AnalysisStatus {
  NONE
  PROCESSING
  DONE
  FAILED
}

model LessonProgress {
  userId      String
  lessonSlug  String
  completedAt DateTime @default(now())

  @@id([userId, lessonSlug])
}

model ContactMessage {
  id        String   @id @default(uuid())
  userId    String?
  name      String
  email     String
  topic     String
  message   String
  createdAt DateTime @default(now())
}
